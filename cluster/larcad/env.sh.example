# Copia a env.sh en el nodo y ajusta con `sinfo` y `module avail gromacs`.
# Este archivo no se sube con secretos; no pongas contraseñas.

# Host para rsync/scp desde tu laptop (no se usa dentro de SLURM):
# ssh -p 212 mixcoha@148.222.27.130
# export LARCAD_HOST="mixcoha@148.222.27.130"
# export LARCAD_PORT="212"
# export LARCAD_REMOTE_DIR="~/cha-md-ba-6m03"

# Cola / cuenta SLURM (déjalo vacío y pásalo a sbatch a mano si no estás seguro):
# export LARCAD_PARTITION="compute"
# export LARCAD_ACCOUNT=""
# export LARCAD_QOS=""
# export LARCAD_TIME="48:00:00"
# export LARCAD_CPUS="8"

# Módulo de GROMACS en el nodo, p. ej. gromacs/2023.3
# export LARCAD_GMX_MODULE="gromacs"
# export GMX="gmx"
