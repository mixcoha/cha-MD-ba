# Copia a env.sh en el nodo:  cp env.sh.example env.sh
# Valores tomados de sinfo / module avail en LARCAD (nodos n[1-4] y gpu1).

# Login (solo para rsync desde la laptop):
# ssh -p 212 mixcoha@148.222.27.130
export LARCAD_HOST="mixcoha@148.222.27.130"
export LARCAD_PORT="212"
export LARCAD_REMOTE_DIR="~/cha-md-ba-6m03"

# --- GPU (1× RTX A5000 en gpu1). Los 3 jobs se encolan uno tras otro. ---
export LARCAD_PARTITION="gpu_rtxA5000"
export LARCAD_GRES="gpu:1"
export LARCAD_MODULES="gcc-15.1.1 mpich-cuda-4.2.3 gromacs-mpi-cuda-2026.2"
export LARCAD_GMX_MODULE="gromacs-mpi-cuda-2026.2"
export LARCAD_CPUS="8"
export LARCAD_USE_GPU="1"
export GMX="gmx_mpi"

# --- CPU en paralelo (n1–n4): ---
# export LARCAD_PARTITION="larcad"
